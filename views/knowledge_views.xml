<odoo>
    <record id="action_knowledge_split" model="ir.actions.client">
        <field name="name">Knowledge Workspace</field>
        <field name="tag">knowledge_split_client</field>
    </record>

    <record id="view_knowledge_article_search" model="ir.ui.view">
        <field name="name">knowledge.article.search</field>
        <field name="model">knowledge.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <field name="tag_ids"/>
                <field name="author_id"/>
                <filter name="filter_mine" string="My Articles" domain="[('author_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="filter_unpublished" string="Unpublished" domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                <filter name="group_parent" string="Parent Article" context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_knowledge_article_tree" model="ir.ui.view">
        <field name="name">knowledge.article.tree</field>
        <field name="model">knowledge.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="views_count" optional="show"/>
                <field name="likes_count" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="write_date" string="Last Updated" widget="remaining_days" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_article_form" model="ir.ui.view">
        <field name="name">knowledge.article.form</field>
        <field name="model">knowledge.article</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article">
                <header>
                    <button name="%(action_knowledge_split)d"
                            type="action"
                            string="Open in Workspace"
                            class="oe_highlight"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_versions"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="not version_ids">
                            <field name="version_ids" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Onboarding guide"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True}" domain="[('id', '!=', id)]"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="author_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="version" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" widget="html" class="o_knowledge_form_content"/>
                        </page>
                        <page string="Access Rights" name="access_rights">
                            <div class="alert alert-info" role="status" invisible="not access_inherited">
                                These rights are the same as the parent article's.
                            </div>
                            <field name="access_inherited" invisible="1"/>
                            <group>
                                <group string="Who Can View">
                                    <field name="view_everyone" widget="boolean_toggle"/>
                                    <field name="view_user_ids" widget="many2many_tags_avatar" options="{'no_create': True}" invisible="view_everyone"/>
                                    <field name="view_department_ids" widget="many2many_tags" options="{'no_create': True}" invisible="view_everyone"/>
                                </group>
                                <group string="Who Can Edit">
                                    <field name="edit_everyone" widget="boolean_toggle"/>
                                    <field name="edit_user_ids" widget="many2many_tags_avatar" options="{'no_create': True}" invisible="edit_everyone"/>
                                    <field name="edit_department_ids" widget="many2many_tags" options="{'no_create': True}" invisible="edit_everyone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_knowledge_tag_list" model="ir.ui.view">
        <field name="name">knowledge.tag.list</field>
        <field name="model">knowledge.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_article_version_tree" model="ir.ui.view">
        <field name="name">knowledge.article.version.tree</field>
        <field name="model">knowledge.article.version</field>
        <field name="arch" type="xml">
            <list string="Article Versions" default_order="create_date desc" create="false">
                <field name="version_number"/>
                <field name="article_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date" string="Saved On"/>
                <button name="action_compare_with_current"
                        string="Compare"
                        type="object"
                        icon="fa-exchange"
                        class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_article_version_form" model="ir.ui.view">
        <field name="name">knowledge.article.version.form</field>
        <field name="model">knowledge.article.version</field>
        <field name="arch" type="xml">
            <form string="Article Version" create="false" edit="false">
                <header>
                    <button name="action_compare_with_current"
                            type="object"
                            string="Compare with Latest"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="version_number"/>
                        <field name="user_id" widget="many2one_avatar_user"/>
                        <field name="create_date" string="Saved On"/>
                    </group>
                    <field name="content" widget="html" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_knowledge_version_compare_wizard_form" model="ir.ui.view">
        <field name="name">knowledge.version.compare.wizard.form</field>
        <field name="model">knowledge.version.compare.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare Versions">
                <field name="article_id" invisible="1"/>
                <group>
                    <field name="old_version_id" readonly="1"/>
                    <field name="current_version_id" readonly="1"/>
                </group>
                <notebook>
                    <page string="Difference" name="difference">
                        <field name="diff_html" widget="html" readonly="1"/>
                    </page>
                    <page string="Old Version" name="old_version">
                        <field name="old_content" widget="html" readonly="1"/>
                    </page>
                    <page string="Current Version" name="current_version">
                        <field name="current_content" widget="html" readonly="1"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
